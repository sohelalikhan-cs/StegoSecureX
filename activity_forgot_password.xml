<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="55dp"
        android:paddingBottom="30dp">

        <!-- ================= HEADER ================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SECURESTEGOX"
            android:textColor="#03162F"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.18"
            android:gravity="center"
            android:shadowColor="#FFFFFF"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="PASSWORD RECOVERY"
            android:textColor="#02152E"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:gravity="center"
            android:shadowColor="#FFFFFF"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4" />

        <!-- ================= ACCENT LINE ================= -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="25dp"
                android:layout_height="2dp"
                android:background="#5636D8" />

            <View
                android:layout_width="48dp"
                android:layout_height="4dp"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:background="#0758C9" />

            <View
                android:layout_width="25dp"
                android:layout_height="2dp"
                android:background="#5636D8" />

        </LinearLayout>

        <!-- ================= SUBTITLE ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:text="Verify your account to securely reset your password"
            android:textColor="#294F7D"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- ================= MAIN CARD ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#F2F7FC"
            android:elevation="10dp"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ================= CARD HEADER ================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FORGOT PASSWORD?"
                android:textColor="#102F57"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Enter your registered details and create a new password"
                android:textColor="#52739A"
                android:textSize="12sp"
                android:gravity="center" />

            <!-- ================= USERNAME ================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="USERNAME"
                android:textColor="#102F57"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:background="#DCE8F5"
                android:hint="Enter your username"
                android:inputType="text"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:textColor="#092746"
                android:textColorHint="#64809F"
                android:textSize="14sp"
                android:singleLine="true" />

            <!-- ================= EMAIL ================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="REGISTERED EMAIL"
                android:textColor="#102F57"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:background="#DCE8F5"
                android:hint="Enter your registered email"
                android:inputType="textEmailAddress"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:textColor="#092746"
                android:textColorHint="#64809F"
                android:textSize="14sp"
                android:singleLine="true" />

            <!-- ================= NEW PASSWORD ================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="NEW PASSWORD"
                android:textColor="#102F57"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:endIconMode="password_toggle"
                app:endIconTint="#31547D">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNewPassword"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:background="#DCE8F5"
                    android:hint="Enter new password"
                    android:inputType="textPassword"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:textColor="#092746"
                    android:textColorHint="#64809F"
                    android:textSize="14sp"
                    android:singleLine="true" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- ================= CONFIRM PASSWORD ================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="CONFIRM PASSWORD"
                android:textColor="#102F57"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:endIconMode="password_toggle"
                app:endIconTint="#31547D">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:background="#DCE8F5"
                    android:hint="Confirm new password"
                    android:inputType="textPassword"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:textColor="#092746"
                    android:textColorHint="#64809F"
                    android:textSize="14sp"
                    android:singleLine="true" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- ================= RESET PASSWORD ================= -->

            <Button
                android:id="@+id/btnResetPassword"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="22dp"
                android:backgroundTint="#1258D4"
                android:elevation="5dp"
                android:text="RESET PASSWORD"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- ================= BACK TO LOGIN ================= -->

            <Button
                android:id="@+id/tvBackToLogin"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="3dp"
                android:backgroundTint="#3F4FAF"
                android:elevation="4dp"
                android:text="←  BACK TO LOGIN"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ================= BOTTOM SECURITY TEXT ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Secure recovery  •  Account protection  •  Trusted access"
            android:textColor="#123B78"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>