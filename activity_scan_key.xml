<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    android:fillViewport="true"
    android:scrollbars="vertical"
    android:fadeScrollbars="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="55dp"
        android:paddingBottom="30dp">

        <!-- ================= HEADER ================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SECURESTEGOX"
            android:textColor="#03162F"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.18"
            android:gravity="center"
            android:shadowColor="#FFFFFF"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4" />

        <TextView
            android:id="@+id/tvScanTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="RECEIVE KEY"
            android:textColor="#02152E"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:gravity="center"
            android:shadowColor="#FFFFFF"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4" />

        <!-- ================= ACCENT LINE ================= -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="25dp"
                android:layout_height="2dp"
                android:background="#5636D8" />

            <View
                android:layout_width="48dp"
                android:layout_height="4dp"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:background="#0758C9" />

            <View
                android:layout_width="25dp"
                android:layout_height="2dp"
                android:background="#5636D8" />

        </LinearLayout>

        <!-- ================= SUBTITLE ================= -->

        <TextView
            android:id="@+id/tvScanSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:text="Securely receive your secret key"
            android:textColor="#294F7D"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- ================= MAIN CARD ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#F2F7FC"
            android:elevation="10dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <!-- ================= INFORMATION ================= -->

            <TextView
                android:id="@+id/tvScanInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#DCE8F5"
                android:padding="14dp"
                android:text="Receive your SecureStegoX secret key using camera, QR image or manual entry."
                android:textColor="#294F7D"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center" />

            <!-- ================= CAMERA SCAN ================= -->

            <Button
                android:id="@+id/btnStartScanner"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#145FE8"
                android:elevation="5dp"
                android:text="SCAN USING CAMERA"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- ================= GALLERY ================= -->

            <Button
                android:id="@+id/btnGalleryQR"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#6338A8"
                android:elevation="4dp"
                android:text="SELECT QR FROM GALLERY"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- ================= OR ================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="OR"
                android:textColor="#31547D"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center" />

            <!-- ================= RECEIVED KEY ================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="RECEIVED SECRET KEY"
                android:textColor="#102F57"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etReceivedKey"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:background="#DCE8F5"
                android:hint="Enter received key"
                android:inputType="textPassword"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:textColor="#092746"
                android:textColorHint="#64809F"
                android:textSize="14sp"
                android:singleLine="true" />

            <!-- ================= CONTINUE ================= -->

            <Button
                android:id="@+id/btnContinue"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="22dp"
                android:backgroundTint="#1258D4"
                android:elevation="5dp"
                android:text="CONTINUE TO DECODE"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- ================= SECURITY WARNING ================= -->

            <TextView
                android:id="@+id/tvReceiveWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="19dp"
                android:background="#FFF3D6"
                android:padding="14dp"
                android:text="⚠  Never share your secret key with an unauthorized person."
                android:textColor="#8A5A00"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center" />

            <!-- ================= BACK ================= -->

            <Button
                android:id="@+id/btnBackDashboard"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="19dp"
                android:layout_marginBottom="3dp"
                android:backgroundTint="#3F4FAF"
                android:elevation="4dp"
                android:text="BACK TO DASHBOARD"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ================= BOTTOM SECURITY TEXT ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Secure receiving • Privacy • Trusted access"
            android:textColor="#123B78"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>