<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Camera permission for QR code scanning -->
    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:allowBackup="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.StegoSecureX">
        <activity
            android:name=".HistoryAdapter"
            android:exported="false" />
        <activity
            android:name=".HistoryModel"
            android:exported="false" />
        <activity
            android:name=".HistoryActivity"
            android:exported="false" />
        <activity
            android:name=".RecoveryActivity"
            android:exported="false" />
        <activity
            android:name=".CryptoUtils"
            android:exported="false" />
        <activity
            android:name=".DatabaseHelper"
            android:exported="false" />
        <activity
            android:name=".DetectionActivity"
            android:exported="false" />
        <activity
            android:name=".DecodeActivity"
            android:exported="false" />
        <activity
            android:name=".EncodeActivity"
            android:exported="false" />

        <!-- Splash -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Auth Screens -->
        <activity
            android:name=".LoginActivity"
            android:exported="false" />
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <!-- Dashboard -->
        <activity
            android:name=".DashboardActivity"
            android:exported="false" />

        <!-- Share Key -->
        <activity
            android:name=".ShareKeyActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Scan Key -->
        <activity
            android:name=".ScanKeyActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ForgotPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".SecurityUtils"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>